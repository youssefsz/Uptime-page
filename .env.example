# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/uptime_db

# Security (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=replace-with-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial admin account (used when the users table is first created)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Monitoring
PING_INTERVAL_SECONDS=30
PING_TIMEOUT_SECONDS=10

# Application server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Optional JSON array of trusted cross-origin frontends. Same-origin access needs none.
CORS_ORIGINS=[]
